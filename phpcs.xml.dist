<?xml version="1.0"?>
<ruleset name="Estatein WordPress">
  <description>WordPress, WordPress-Extra, and PHP 8.3+ compatibility checks.</description>

  <file>wp-content/themes/estatein</file>
  <file>wp-content/plugins/estatein-core</file>

  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>

  <arg name="basepath" value="." />
  <arg name="colors" />
  <arg name="extensions" value="php" />
  <arg name="parallel" value="8" />
  <arg name="report" value="full" />
  <config name="minimum_supported_wp_version" value="7.0" />
  <config name="testVersion" value="8.3-" />

  <rule ref="WordPress" />
  <rule ref="WordPress-Extra" />
  <rule ref="PHPCompatibilityWP" />

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="estatein" />
        <element value="estatein-core" />
      </property>
    </properties>
  </rule>

  <!-- WordPress requires the literal underscored CPT slug in these template names. -->
  <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
    <exclude-pattern>wp-content/themes/estatein/archive-estatein_property.php</exclude-pattern>
    <exclude-pattern>wp-content/themes/estatein/single-estatein_property.php</exclude-pattern>
  </rule>
</ruleset>
