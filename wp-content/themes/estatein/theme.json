{
  "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "grey-08", "name": "Grey 08", "color": "#141414" },
        { "slug": "grey-10", "name": "Grey 10", "color": "#1A1A1A" },
        { "slug": "grey-15", "name": "Grey 15", "color": "#262626" },
        { "slug": "grey-20", "name": "Grey 20", "color": "#333333" },
        { "slug": "grey-30", "name": "Grey 30", "color": "#4D4D4D" },
        { "slug": "grey-40", "name": "Grey 40", "color": "#666666" },
        { "slug": "grey-50", "name": "Grey 50", "color": "#808080" },
        { "slug": "grey-60", "name": "Grey 60", "color": "#999999" },
        { "slug": "purple-60", "name": "Purple 60", "color": "#703BF7" },
        { "slug": "purple-75", "name": "Purple 75", "color": "#A685FA" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1596px"
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "2XS", "size": "8px" },
        { "slug": "30", "name": "XS", "size": "12px" },
        { "slug": "40", "name": "Small", "size": "16px" },
        { "slug": "50", "name": "Medium", "size": "24px" },
        { "slug": "60", "name": "Large", "size": "40px" },
        { "slug": "70", "name": "XL", "size": "64px" },
        { "slug": "80", "name": "2XL", "size": "96px" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Urbanist, system-ui, sans-serif",
          "name": "Urbanist",
          "slug": "urbanist",
          "fontFace": [
            {
              "fontFamily": "Urbanist",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/urbanist-latin.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "medium", "name": "Medium", "size": "18px" },
        { "slug": "large", "name": "Large", "size": "30px" },
        { "slug": "x-large", "name": "Extra Large", "size": "48px" }
      ]
    }
  },
  "styles": {
    "color": { "background": "#141414", "text": "#FFFFFF" },
    "spacing": { "blockGap": "24px" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--urbanist)",
      "fontSize": "18px",
      "fontWeight": "400",
      "lineHeight": "1.5"
    },
    "elements": {
      "heading": { "color": { "text": "#FFFFFF" }, "typography": { "fontWeight": "600", "lineHeight": "1.2" } },
      "link": { "color": { "text": "#FFFFFF" } }
    }
  }
}
